[mesh]
n_cell_global = 64 2 2
x_min         = -5 0 0
x_max         = 5 1 1

[cycle]
prefix_output  = pipeline
n_cycle_lim    = 0
n_display_freq = 1
t_lim          = 1.2e-1
dt_output      = 1e32
t_output_next  = 1e32
final_output   = 1
output_mesh    = 1

[unit]
length   = 1.49598e13
time     = 1.0
density  = 1.0

[particle]
step_max        = 200000
n_step          = 200000
n_scat          = 10000
n_photon        = 10000
output          = 0

[line_rt]
field_file      = fields_cycle0.bin
field_fixed_file = fields_fixed.bin
photon_file     = photons_cycle0.bin
photon_pref     = par
ph_mode         = 0          ; 0=CFR (Gaussian), 1/2/3=R_IIA (USampler)
b_sca           = 1
num_rng         = 16381
n_ph_read       = -1
const_abs       = 1
n_fld           = 1
a_voigt         = 0       ; Voigt damping parameter (0 = pure Gaussian)
proper_min_frac = 0       ; proper-weight culling threshold (0 = disabled)
worker_mode     = 0       ; 1 = server-worker photon scheduling (GPU work queue)

[boundary]
kinds = fre fre fre fre fre fre

[imaging]
; Line imaging: a non-scattering ray-tracing pass that
; integrates the transfer equation along camera rays using
; the scattering source function (st_cam) accumulated by the
; MC pass.  Runs only when enabled=1 (default off).
enabled         = 0
n_chan          = 32           ; number of velocity channels
dir_cam_theta   = 0.7853982    ; camera direction (polar angle [rad])
dir_cam_phi     = 0.0          ; camera azimuth [rad]
v_chan_min      = -1e5         ; channel velocity range [cm/s, CGS]
v_chan_max      = 1e5
; img_xmin       = 0 0          ; image-plane corner [code units]
; img_xmax       = 1 1
; img_resol      = 64 64        ; pixel resolution
