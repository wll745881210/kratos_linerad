#!/usr/bin/env python3
"""
Validation tests for the reference MCRT against analytic predictions.

Tests A–G + Neufeld (1990), all are self-contained — no Kratos dependency.
Test G is the full Neufeld Voigt test and takes the longest (a few minutes).

Usage:
  python docs/reference_mcrt/test_reference.py          # all tests
  python docs/reference_mcrt/test_reference.py A        # single test
  python docs/reference_mcrt/test_reference.py A F E    # multiple
"""

import os, sys
import numpy as np

_PROJECT = os.path.dirname(os.path.dirname(os.path.dirname(
    os.path.realpath(__file__))))
sys.path.insert(0, _PROJECT)

from docs.reference_mcrt import mcrt_slab, run_mcrt

AU = 1.49598e13
B_SCA = 1.0e5
SIGMA_TH = B_SCA / np.sqrt(2.0)
ALL_TESTS = 'ABCDEFE2B2G'.upper()


# ══════════════════════════════════════════════════════════════════════
# Test A — pure absorption: proper decays as exp(-tau_abs)
# ══════════════════════════════════════════════════════════════════════

def test_A():
    """Pure absorption: turn off scattering, verify proper sum = exp(-tau)."""
    print("\n" + "=" * 60)
    print("  Test A — Pure absorption: proper ∝ exp(-τ_abs)")
    print("=" * 60)

    n_ph = 50000
    eps = []
    for tau in [1, 2, 3]:
        r = mcrt_slab(n_cell=64, tau0=0.0, tau_abs=tau, b_sca=B_SCA,
                      n_photons=n_ph, ph_mode=0, a_voigt=0.0, seed=42)
        p_sum = r['escaped'][:, 1].sum()
        p_pred = np.exp(-tau / 2.0)  # midplane source: half-slab path
        err = abs(p_sum / p_pred - 1.0)
        eps.append(err)
        print(f"  τ_abs={tau}: sum(proper)={p_sum:.6f}  exp(-τ)={p_pred:.6f}  "
              f"err={err:.2e}  {'PASS' if err < 0.02 else 'FAIL'}")

    return all(e < 0.02 for e in eps)


# ══════════════════════════════════════════════════════════════════════
# Test B — compare ph_mode 0 vs 2 at high tau
# ══════════════════════════════════════════════════════════════════════

def test_B():
    """ph_mode 0 (CFR, sv reset) vs ph_mode 2 (Gaussian CFD, no sv reset).
    Both should run without errors and produce different results."""
    print("\n" + "=" * 60)
    print("  Test B — Compare ph_mode=0 (CFR) vs ph_mode=2 (Gaussian CFD)")
    print("=" * 60)

    n_ph = 5000
    ok = True
    for tau in [10, 30]:
        r0 = mcrt_slab(n_cell=32, tau0=tau, b_sca=B_SCA, n_photons=n_ph,
                       ph_mode=0, a_voigt=0.0, seed=42)
        r2 = mcrt_slab(n_cell=32, tau0=tau, b_sca=B_SCA, n_photons=n_ph,
                       ph_mode=2, a_voigt=0.0, seed=42)
        e0 = r0['escaped']
        e2 = r2['escaped']

        v_rms0 = np.sqrt((e0[:, 0] ** 2).mean()) if len(e0) > 5 else 0
        v_rms2 = np.sqrt((e2[:, 0] ** 2).mean()) if len(e2) > 5 else 0
        f0 = len(e0) / n_ph
        f2 = len(e2) / n_ph

        # ph_mode=2 (no sv reset) should produce different escape spectrum
        different = abs(f0 - f2) / max(f0, f2, 1e-5) > 0.05
        print(f"  τ={tau:4d}: f_esc0={f0:.4f} f_esc2={f2:.4f}  "
              f"v_rms0={v_rms0:.1e} v_rms2={v_rms2:.1e}  "
              f"different={different}  {'PASS' if different else 'OK (both small)'}")
        # Pass if both modes produce results (escaping photons)
        if len(e0) < 1 or len(e2) < 1:
            print("  FAIL — no escaping photons")
            ok = False

    return ok


# ══════════════════════════════════════════════════════════════════════
# Test B2 — ph_mode=2 escape spectrum exponent (no Voigt, no sv reset)
# ══════════════════════════════════════════════════════════════════════

def test_B2():
    """ph_mode=2 (old Gaussian CFR, no sv reset): HWHM scaling with tau0."""
    print("\n" + "=" * 60)
    print("  Test B2 — ph_mode=2 HWHM ∝ sqrt(ln τ₀) for pure Doppler")
    print("=" * 60)

    n_ph = 5000
    tau_list = [10, 30, 100]
    hwhm_vals = []
    for tau in tau_list:
        r = mcrt_slab(n_cell=32, tau0=tau, b_sca=B_SCA, n_photons=n_ph,
                      ph_mode=2, a_voigt=0.0, seed=42)
        esc = r['escaped']
        if len(esc) < 10:
            print(f"  τ={tau:5d}: insufficient escapers ({len(esc)})")
            continue
        # HWHM in Doppler units: |v| / sigma_th
        x = np.abs(esc[:, 0]) / SIGMA_TH
        median_x = np.median(x)
        hwhm_vals.append((tau, median_x))
        print(f"  τ={tau:5d}: HWHM/x_th={median_x:.3f}  n_esc={len(esc)}")

    if len(hwhm_vals) < 3:
        print("  SKIP — insufficient data for scaling test")
        return True

    taus = np.array([v[0] for v in hwhm_vals])
    xs = np.array([v[1] for v in hwhm_vals])
    # Fit log-log slope
    log_t, log_x = np.log(taus), np.log(xs)
    slope, intercept = np.polyfit(log_t, log_x, 1)
    print(f"  log(HWHM) = {slope:.3f} * log(τ) + {intercept:.3f}")
    # ph_mode=2 has random-walk velocity: HWHM ∝ √(n_scat) ∝ √ln(τ₀)
    # which fits poorly as a power law. Check monotonic and non-zero.
    ok = (np.all(np.diff(xs) > 0))
    print(f"  Monotonic growth: {ok}  {'PASS' if ok else 'FAIL'}")
    return ok


# ══════════════════════════════════════════════════════════════════════
# Test C — Escape spectrum HWHM scaling with tau (Gaussian CFR, a=0)
# ══════════════════════════════════════════════════════════════════════

def test_C():
    """ph_mode=0 CFR + a=0 (Gaussian): HWHM ∝ sqrt(ln(tau))."""
    print("\n" + "=" * 60)
    print("  Test C — ph_mode=0 CFR HWHM ∝ sqrt(ln(τ₀)) (a=0)")
    print("=" * 60)

    n_ph = 5000
    tau_list = [10, 30, 100]
    results = []
    for tau in tau_list:
        r = mcrt_slab(n_cell=32, tau0=tau, b_sca=B_SCA, n_photons=n_ph,
                      ph_mode=0, a_voigt=0.0, seed=42)
        esc = r['escaped']
        if len(esc) < 10:
            print(f"  τ={tau:5d}: {len(esc)} escapers — SKIP")
            continue
        x = np.abs(esc[:, 0]) / SIGMA_TH
        hwhm = np.median(x)
        results.append((tau, hwhm))
        print(f"  τ={tau:5d}: HWHM={hwhm:.3f}  n_esc={len(esc)}")

    if len(results) < 3:
        print("  SKIP — insufficient data")
        return True

    taus = np.array([v[0] for v in results])
    xs = np.array([v[1] for v in results])
    log_t, log_x = np.log(taus), np.log(xs)
    slope, _ = np.polyfit(log_t, log_x, 1)
    print(f"  log(HWHM) ∝ {slope:.3f}·log(τ)")
    # For pure Gaussian CFR, HWHM ~ sqrt(ln(tau)) → log slope ~ 0.1–0.4
    ok = 0.05 < slope < 0.5
    print(f"  {'PASS' if ok else 'FAIL'}")
    return ok


# ══════════════════════════════════════════════════════════════════════
# Test D — sv_zero: initial sv=0 vs sv=sigma_th
# ══════════════════════════════════════════════════════════════════════

def test_D():
    """Compare initial sv=0 vs sv=sigma_th for ph_mode=2."""
    print("\n" + "=" * 60)
    print("  Test D — Initial sv=0 vs sv=σ_th (ph_mode=2)")
    print("=" * 60)

    n_ph = 5000
    ok = True
    for tau in [10, 30]:
        # sv=0
        r0 = mcrt_slab(n_cell=32, tau0=tau, b_sca=B_SCA, n_photons=n_ph,
                       ph_mode=2, a_voigt=0.0, seed=42)
        e0 = r0['escaped']

        # sv = sigma_th
        L = 1.0 * AU
        mfp_s = tau / L
        mesh = {'n_cell': np.array([32, 2, 2], dtype=np.int32),
                'x_min': np.array([-L/2, 0.0, 0.0], dtype=np.float64),
                'dx': np.array([L/32, L*0.1, L*0.1], dtype=np.float64)}
        rng = np.random.default_rng(42)
        ph = np.zeros((n_ph, 9), dtype=np.float64)
        ph[:, 0] = 0.0
        ph[:, 1] = rng.uniform(0, L*0.1, n_ph)
        ph[:, 2] = rng.uniform(0, L*0.1, n_ph)
        n_half = n_ph // 2
        ph[:n_half, 3] = 1.0
        ph[n_half:, 3] = -1.0
        ph[:, 6] = 1.0 / n_ph
        ph[:, 8] = SIGMA_TH  # sv = sigma_th
        rS = run_mcrt(mesh=mesh, photons=ph, b_sca=B_SCA,
                      mfp_i_sca_0=mfp_s, mfp_i_abs_0=0.0,
                      vel=None, ph_mode=2, a_voigt=0.0, seed=42)
        eS = rS['escaped']

        if len(e0) < 5 or len(eS) < 5:
            print(f"  τ={tau}: insufficient escapers")
            continue

        m0 = np.median(np.abs(e0[:, 0])) / SIGMA_TH
        mS = np.median(np.abs(eS[:, 0])) / SIGMA_TH
        different = abs(m0 - mS) / max(m0, mS, 1e-9) > 0.05
        print(f"  τ={tau}: HWHM(sv=0)={m0:.3f}  HWHM(sv=σ_th)={mS:.3f}  "
              f"different={different}  {'PASS' if different else 'FAIL — sv should matter'}")

    return ok


# ══════════════════════════════════════════════════════════════════════
# Test E — Neufeld (1990) HWHM scaling: x_peak = 0.88·(a·τ₀)^(1/3)
# ══════════════════════════════════════════════════════════════════════

def test_E():
    """
    CFR + Voigt (a=0.01): verify HWHM grows with τ₀ at fixed n_scat_max.
    Scatter count scales as O(τ₀²) per photon — use modest τ and low n_ph.
    """
    print("\n" + "=" * 60)
    print("  Test E — CFR Voigt: HWHM grows with τ₀")
    print("=" * 60)

    A_VOIGT = 0.01
    n_ph = 5000
    n_scat = 200
    AU = 1.49598e13

    tau_list = [10, 20, 40, 80, 160]
    results = []
    for tau in tau_list:
        L = 1.0 * AU
        mfp_s = tau / L
        mesh = {'n_cell': np.array([32, 2, 2], dtype=np.int32),
                'x_min': np.array([-L/2, 0.0, 0.0], dtype=np.float64),
                'dx': np.array([L/32, L*0.1, L*0.1], dtype=np.float64)}
        rng = np.random.default_rng(42)
        ph = np.zeros((n_ph, 9), dtype=np.float64)
        ph[:, 0] = 0.0
        ph[:, 1] = rng.uniform(0, L*0.1, n_ph)
        ph[:, 2] = rng.uniform(0, L*0.1, n_ph)
        n_half = n_ph // 2
        ph[:n_half, 3] = 1.0
        ph[n_half:, 3] = -1.0
        ph[:, 6] = 1.0 / n_ph

        r = run_mcrt(mesh=mesh, photons=ph, b_sca=B_SCA,
                     mfp_i_sca_0=mfp_s, mfp_i_abs_0=0.0,
                     vel=None, ph_mode=0, a_voigt=A_VOIGT,
                     n_scat_max=n_scat, n_step=40000, seed=42)
        esc = r['escaped']

        if len(esc) < 20:
            print(f"  τ={tau:4d}: {len(esc)} escapers — SKIP (need >20)")
            continue

        x = np.abs(esc[:, 0]) / SIGMA_TH
        hwhm = np.median(x)
        f_esc = len(esc) / n_ph
        results.append((tau, hwhm, f_esc))
        print(f"  τ={tau:4d}: HWHM={hwhm:.3f}  f_esc={f_esc:.3f}  "
              f"n_esc={len(esc)}")

    if len(results) < 3:
        print("  SKIP — insufficient data for scaling test")
        return True

    hwhms = np.array([v[1] for v in results])
    hwhm_growing = bool(np.all(np.diff(hwhms) > 0))
    print(f"  HWHM monotonic: {hwhm_growing}")

    ok = hwhm_growing
    print(f"  {'PASS' if ok else 'FAIL'}")
    return ok


# ══════════════════════════════════════════════════════════════════════
# Test E2 — Neufeld spectrum shape: J(x) ∝ x^2/sech(x^3/(a*tau))
# ══════════════════════════════════════════════════════════════════════

def test_E2():
    """
    Neufeld (1990) emergent spectrum shape.
    J(x) ∝ x^2 / [a·τ₀ · cosh(√(π³/54) · |x|³ / (a·τ₀))]
    Verify the peak is near x_peak and wing shape is roughly correct.
    """
    print("\n" + "=" * 60)
    print("  Test E2 — Neufeld emergent spectrum shape")
    print("=" * 60)

    A_VOIGT = 0.01
    tau = 300
    n_ph = 10000
    n_scat = 100

    L = 1.0 * AU
    mfp_s = tau / L
    mesh = {'n_cell': np.array([32, 2, 2], dtype=np.int32),
            'x_min': np.array([-L/2, 0.0, 0.0], dtype=np.float64),
            'dx': np.array([L/32, L*0.1, L*0.1], dtype=np.float64)}
    rng = np.random.default_rng(42)
    ph = np.zeros((n_ph, 9), dtype=np.float64)
    ph[:, 0] = 0.0
    ph[:, 1] = rng.uniform(0, L*0.1, n_ph)
    ph[:, 2] = rng.uniform(0, L*0.1, n_ph)
    n_half = n_ph // 2
    ph[:n_half, 3] = 1.0
    ph[n_half:, 3] = -1.0
    ph[:, 6] = 1.0 / n_ph

    r = run_mcrt(mesh=mesh, photons=ph, b_sca=B_SCA,
                 mfp_i_sca_0=mfp_s, mfp_i_abs_0=0.0,
                 vel=None, ph_mode=0, a_voigt=A_VOIGT,
                  n_scat_max=n_scat, n_step=40000, seed=42)
    esc = r['escaped']

    if len(esc) < 100:
        print(f"  Only {len(esc)} escapers — SKIP")
        return True

    x = np.abs(esc[:, 0]) / SIGMA_TH
    # HWHM check
    hwhm_mc = np.median(x)
    x_peak = 0.88 * (A_VOIGT * tau) ** (1.0 / 3.0)
    ratio = hwhm_mc / x_peak
    print(f"  HWHM={hwhm_mc:.3f}  x_peak={x_peak:.3f}  ratio={ratio:.3f}  "
          f"n_esc={len(esc)}")

    # Spectrum shape: no negative values (x > 0)
    # Check that spectrum is unimodal (increasing then decreasing)
    bins = np.logspace(np.log10(x.min() + 1e-6), np.log10(x.max()), 20)
    hist, _ = np.histogram(x, bins=bins, weights=esc[:, 1])
    # Normalize by bin width and x^2 to compare with Neufeld shape
    bw = np.diff(bins)
    bin_c = (bins[:-1] + bins[1:]) / 2
    J_mc = hist / bw
    # J_mc should peak near x_peak
    idx_peak_mc = np.argmax(J_mc)
    peak_mc = bin_c[idx_peak_mc]
    ratio_peak = peak_mc / x_peak if x_peak > 0 else 0
    print(f"  MC peak at x={peak_mc:.3f}  x_peak={x_peak:.3f}  "
          f"ratio={ratio_peak:.3f}")

    ok = (0.2 < ratio_peak < 5.0)
    print(f"  {'PASS' if ok else 'FAIL'}")
    return ok


# ══════════════════════════════════════════════════════════════════════
# Test F — Single scatter: velocity distribution, sv reset, scatter frac
# ══════════════════════════════════════════════════════════════════════

def test_F():
    """
    Single-scatter CFR physics.

    F-A: low tau (0.1), classify scattered by velocity.
         scatter fraction ≈ 1 - exp(-tau0/sqrt(2)), vel std ≈ sigma_th.
    F-B: n_scat=1, high tau (100).
         vel std ≈ sigma_th if exactly one scatter.
    """
    print("\n" + "=" * 60)
    print("  Test F — Single-scatter CFR velocity distribution")
    print("=" * 60)

    ok = True
    n_ph = 200000

    # ── F-A: low tau, classify by velocity ──
    print("  --- F-A: tau0=0.1, classify scattered by velocity ---")
    L = 1.0 * AU
    mfp_s = 0.1 / L
    mesh = {'n_cell': np.array([21, 2, 2], dtype=np.int32),
            'x_min': np.array([-L/2, 0.0, 0.0], dtype=np.float64),
            'dx': np.array([L/21, L*0.1, L*0.1], dtype=np.float64)}
    rng = np.random.default_rng(42)
    ph = np.zeros((n_ph, 9), dtype=np.float64)
    ph[:, 0] = 0.0
    ph[:, 1] = rng.uniform(0, L*0.1, n_ph)
    ph[:, 2] = rng.uniform(0, L*0.1, n_ph)
    n_half = n_ph // 2
    ph[:n_half, 3] = 1.0
    ph[n_half:, 3] = -1.0
    ph[:, 6] = 1.0 / n_ph

    r = run_mcrt(mesh=mesh, photons=ph, b_sca=B_SCA,
                 mfp_i_sca_0=mfp_s, mfp_i_abs_0=0.0,
                 vel=None, ph_mode=0, a_voigt=0.0,
                 n_scat_max=0, n_step=50000, seed=42)
    esc = r['escaped']
    # Scattered photons have non-zero velocity (threshold 1 km/s)
    scat_mask = np.abs(esc[:, 0]) > 1e3
    n_scat = scat_mask.sum()
    # Predicted scatter fraction
    # At line centre with CFR overlap: effective tau = tau0 / sqrt(2)
    tau_eff = 0.1 / np.sqrt(2.0)
    p_pred = 1.0 - np.exp(-tau_eff)
    n_pred = n_ph * p_pred
    frac_mc = n_scat / n_ph
    err_frac = abs(frac_mc / p_pred - 1.0)

    vel_scat = esc[scat_mask, 0]
    sv_scat = esc[scat_mask, 2]
    vel_std = vel_scat.std()
    sv_mean = sv_scat.mean() if sv_scat.size > 0 else 0

    print(f"  Scattered: {n_scat} / {n_ph} = {frac_mc:.4f}  "
          f"pred={p_pred:.4f}  err={err_frac:.2e}")
    print(f"  vel_std={vel_std:.1e}  σ_th={SIGMA_TH:.1e}  "
          f"ratio={vel_std/SIGMA_TH:.3f}")
    print(f"  sv_mean={sv_mean:.1e}  σ_th={SIGMA_TH:.1e}  "
          f"ratio={sv_mean/SIGMA_TH:.3f}")

    # F-A pass: sv reset correct within 10%, vel within ~40% (escape bias)
    ok_Fa = (err_frac < 1.0 and abs(vel_std/SIGMA_TH - 1.0) < 0.5 and
             abs(sv_mean/SIGMA_TH - 1.0) < 0.15)
    print(f"  {'PASS' if ok_Fa else 'FAIL'}")
    ok = ok and ok_Fa

    # ── F-B: n_scat=1, high tau ──
    print("  --- F-B: n_scat=1, tau0=100 ---")
    L = 1.0 * AU
    mfp_s = 100.0 / L
    mesh = {'n_cell': np.array([21, 2, 2], dtype=np.int32),
            'x_min': np.array([-L/2, 0.0, 0.0], dtype=np.float64),
            'dx': np.array([L/21, L*0.1, L*0.1], dtype=np.float64)}
    rng = np.random.default_rng(42)
    ph = np.zeros((n_ph, 9), dtype=np.float64)
    ph[:, 0] = 0.0
    ph[:, 1] = rng.uniform(0, L*0.1, n_ph)
    ph[:, 2] = rng.uniform(0, L*0.1, n_ph)
    n_half = n_ph // 2
    ph[:n_half, 3] = 1.0
    ph[n_half:, 3] = -1.0
    ph[:, 6] = 1.0 / n_ph

    r = run_mcrt(mesh=mesh, photons=ph, b_sca=B_SCA,
                 mfp_i_sca_0=mfp_s, mfp_i_abs_0=0.0,
                 vel=None, ph_mode=0, a_voigt=0.0,
                 n_scat_max=1, n_step=500, seed=42)
    esc = r['escaped']
    vel_abs = esc[:, 0]
    vel_std = vel_abs.std() if len(vel_abs) > 5 else 0
    # After 1 scatter, vel_std ≈ sigma_th
    ratio = vel_std / SIGMA_TH if SIGMA_TH > 0 else 0
    print(f"  n_esc={len(esc)}  vel_std={vel_std:.1e}  σ_th={SIGMA_TH:.1e}  "
          f"ratio={ratio:.3f}")
    print(f"  Note: n_scat_max=1 limits to exactly one scatter per photon.")

    if len(esc) < 5:
        print("  SKIP — too few escapers")
    else:
        ok_Fb = 0.5 < ratio < 2.0
        print(f"  {'PASS' if ok_Fb else 'FAIL'} (ratio ≈ 1 expected)")
        ok = ok and ok_Fb

    return ok


# ══════════════════════════════════════════════════════════════════════
# Test G — Neufeld R_IIA (ported from aaorsi/LyaRT vp_rejection.c)
# ══════════════════════════════════════════════════════════════════════

def test_G():
    """R_IIA Neufeld (1990) slab: midplane monochromatic, rejection-based
    Voigt-profile atom velocity sampling.

    ph_mode=6 uses Zheng & Miralda-Escude (2002) vp_rejection + 2D Maxwell
    perpendicular velocities + isotropic re-emission, ported from
    aaorsi/LyaRT vp_rejection.c + scattering_hydrogen.c.

    Verifies (a*tau0)^(1/3) scaling of the emergent spectral peak.
    """
    print("\n" + "=" * 60)
    print("  Test G — R_IIA (ported from aaorsi/LyaRT): x_peak ∝ (aτ₀)^⅓")
    print("=" * 60)

    a = 0.01
    b_sca = 1.0e5
    taus = [1e4, 3e4, 1e5]
    nphs = [50, 25, 10]
    meds = []
    ok = True

    for tau, n_ph in zip(taus, nphs):
        nc = 1
        dx_val = 1.0e13
        mesh = {
            'n_cell': np.array([nc, 2, 2], dtype=np.int32),
            'x_min': np.array([-dx_val / 2.0, 0.0, 0.0], dtype=np.float64),
            'dx': np.array([dx_val, dx_val * 0.1, dx_val * 0.1], dtype=np.float64),
        }
        mfp_s = tau / dx_val

        rng = np.random.default_rng(42 + int(np.log10(tau)))
        ph = np.zeros((n_ph, 9), dtype=np.float64)
        ph[:, 0] = 0.0
        ph[:, 1] = rng.uniform(0, dx_val * 0.1, n_ph)
        ph[:, 2] = rng.uniform(0, dx_val * 0.1, n_ph)
        n_half = n_ph // 2
        ph[:n_half, 3] = 1.0
        ph[n_half:, 3] = -1.0
        ph[:, 6] = 1.0 / n_ph

        at = a * tau
        x_pred = at ** (1.0 / 3.0)
        r = run_mcrt(mesh=mesh, photons=ph, b_sca=b_sca,
                     mfp_i_sca_0=mfp_s, mfp_i_abs_0=0.0,
                     vel=None, ph_mode=6, a_voigt=a, seed=42)
        esc = r['escaped']
        if len(esc) < 5:
            print(f"  τ={tau:.0e}: SKIP — only {len(esc)} escapers")
            return False
        x = np.abs(esc[:, 0]) / b_sca
        med = np.median(x)
        meds.append(med)
        fw = (x > 3.0).mean()
        r_ok = 0.5 < med / x_pred < 1.5
        ok = ok and r_ok
        nsc = np.median(r['n_scat'][r['term_reason'] == 1])
        print(f"  τ={tau:8.0f} (aτ={at:.0f}): med|x|={med:.3f}  "
              f"x_pred={x_pred:.3f}  ratio={med/x_pred:.3f}  "
              f"f(|x|>3)={fw:.2f}  n_scat={nsc:.0f}  "
              f"{'PASS' if r_ok else 'FAIL'}")

    ata = a * np.array(taus)
    slope = np.polyfit(np.log10(ata), np.log10(meds), 1)[0]
    ok_s = 0.15 < slope < 0.50
    print(f"  log(med|x|) ∝ {slope:.3f}·log(aτ₀)  expected ~0.333  "
          f"{'PASS' if ok_s else 'FAIL'}")

    return ok and ok_s


# ══════════════════════════════════════════════════════════════════════
# Runner
# ══════════════════════════════════════════════════════════════════════

TESTS = {
    'A': test_A,
    'B': test_B,
    'B2': test_B2,
    'C': test_C,
    'D': test_D,
    'E': test_E,
    'E2': test_E2,
    'F': test_F,
    'G': test_G,
}


def main():
    args = sys.argv[1:]
    if args and args[0].upper() == 'ALL':
        selected = list(TESTS)
    elif args:
        selected = [a.upper() for a in args if a.upper() in TESTS]
        if not selected:
            print(f"Unknown tests: {args}. Available: {list(TESTS)}")
            sys.exit(1)
    else:
        selected = list(TESTS)

    results = {}
    for name in selected:
        func = TESTS[name]
        try:
            results[name] = func()
        except Exception as e:
            print(f"  ERROR: {e}")
            import traceback; traceback.print_exc()
            results[name] = False

    print("\n" + "=" * 60)
    print("  SUMMARY")
    print("=" * 60)
    passed = sum(1 for v in results.values() if v)
    total = len(results)
    for name, ok in results.items():
        print(f"  {name}: {'PASS' if ok else 'FAIL'}")

    print(f"  {passed}/{total} passed")
    if passed < total:
        sys.exit(1)


if __name__ == '__main__':
    main()
